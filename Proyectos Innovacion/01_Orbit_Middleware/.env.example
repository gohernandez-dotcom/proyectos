# ==============================================================================
# ORBIT MIDDLEWARE - VARIABLES DE ENTORNO
# ==============================================================================
# Versión de Python recomendada: 3.11.0+
PYTHON_VERSION=3.11.0
PORT=8000

# ------------------------------------------------------------------------------
# 1. Inteligencia Artificial (Google Gemini)
# Obtén tu API Key gratuita en: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# ------------------------------------------------------------------------------
# 2. Servidor MCP y Supabase
# ------------------------------------------------------------------------------
MCP_URL=http://localhost:8001
MCP_TOKEN=token_opcional_mcp
MCP_TIMEOUT=5
MCP_MAX_RETRIES=3

SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_clave_anonima_de_supabase_aqui

# ------------------------------------------------------------------------------
# 3. Caché y Circuit Breaker (Redis)
# Puedes usar un servicio como Upstash Redis o Redis local
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_TIMEOUT=60

# ------------------------------------------------------------------------------
# 4. Seguridad de Webhooks (Respond.io)
# Token secreto para validar firmas de webhooks entrantes
# ------------------------------------------------------------------------------
WEBHOOK_SECRET=genera_un_token_secreto_seguro_aqui

# ------------------------------------------------------------------------------
# 5. Dashboard y Monitoreo Interno
# ------------------------------------------------------------------------------
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=cambiar_password_seguro_aqui

# ------------------------------------------------------------------------------
# 6. Google Cloud Platform / Service Account (Base64)
# JSON de la Service Account convertido a Base64 para Google Chat / Sheets
# ------------------------------------------------------------------------------
GOOGLE_CHATS_SA_BASE64=
